# Response headers for the Cloudflare deployment (wrangler.jsonc). The same
# headers as nginx.conf and security-headers.inc, which still serve the image
# built from the Dockerfile: keep them in step.
#
# Pages carry no fingerprint, so they keep Cloudflare's default Cache-Control
# (max-age=0, must-revalidate). A deploy then shows up on the next request.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints these, so a new deploy means new file names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og-cover.png
  Cache-Control: public, max-age=604800

/placeholder.svg
  Cache-Control: public, max-age=604800

# Regenerated on every build; a stale copy would advertise pages that moved.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
